---
import MotsLayout from '../../layouts/MotsLayout.astro';
import words from '../../data/mots.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const LEX = [
  { key: 'humaine',   label: 'Humain' },
  { key: 'numerique', label: 'Numérique' },
  { key: 'agent',     label: 'Agent' },
  { key: 'vivant',    label: 'Vivant' },
  { key: 'anthropie', label: 'Anthropie' },
  { key: 'lutte',     label: 'Lutte' },
  { key: 'generaux',  label: 'Nécessaires' },
];
function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function inline(s) {
  s = esc(s);
  s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  return s;
}
function norm(s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
---
<MotsLayout title="Le recueil" active="recueil" wide={true}>
  <header class="read-head">
    <p class="kicker">{words.length} mots</p>
    <h1>Le recueil</h1>
    <p class="lede">Les quatre cent septante-huit mots, d'un seul tenant. Cherche par le mot, par une racine grecque, ou par l'expérience qu'il nomme.</p>
  </header>

  <div class="search">
    <input id="q" type="search" placeholder="Chercher…" autocomplete="off" aria-label="Chercher un mot" />
    <div class="chips" role="group" aria-label="Filtrer par lexique">
      <button class="chip active" data-lex="">Tous <i>{words.length}</i></button>
      {LEX.map((l) => (
        <button class={`chip lex-${l.key}`} data-lex={l.key}>{l.label} <i>{words.filter((w) => w.lexique === l.key).length}</i></button>
      ))}
      <button class="chip ghost" id="rand" type="button" title="Un mot au hasard">⤳ au hasard</button>
    </div>
    <p class="rc" id="count" aria-live="polite"></p>
  </div>

  <div class="grid" id="list">
    {words.map((w) => (
      <article class={`entry lex-${w.lexique}`} id={w.slug} data-lex={w.lexique} data-search={norm(w.mot + ' ' + w.etym + ' ' + w.corps + ' ' + w.facette)}>
        <div class="entry-head">
          <h3 class="lemma"><a href={`${base}/mots/m/${w.slug}/`}>{w.mot}</a></h3>
          <div class="tags"><span class="langue">{w.langue}</span><span class="lex-tag">{w.lexique_label}</span></div>
        </div>
        <p class="etym" set:html={inline(w.etym)}></p>
        <p class="corps" set:html={inline(w.corps)}></p>
        {w.miroirs.length > 0 && (
          <div class="miroirs">
            <span class="mlabel">↔&nbsp;</span>
            {w.miroirs.map((m) => (
              <a class="miroir" style={`--mlex: var(--lex-${m.lexique})`} href={`${base}/mots/m/${m.slug}/`} title={`${m.type}${m.forme ? ' — ' + m.forme : ''}`}>
                <span class="dot"></span>{m.mot}
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
  <p id="empty" class="empty" hidden>Aucun mot ne correspond. <button id="clear" class="chip ghost">tout afficher</button></p>

  <style>
    .read-head { text-align: center; margin: 0 0 1.6rem; }
    .read-head .kicker { font-family: 'Inter', sans-serif; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold); margin: 0 0 0.5rem; }
    .read-head h1 { font-family: 'Fraunces', serif; font-weight: 400; font-size: 2.7rem; margin: 0 0 0.6rem; }
    .read-head .lede { color: var(--ink-soft); font-style: italic; font-size: 1.08rem; }
    .search { position: sticky; top: 0; z-index: 20; background: var(--vellum); padding: 0.9rem 0 0.8rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.6rem; }
    #q { width: 100%; font-family: 'Fraunces', serif; font-size: 1.3rem; padding: 0.7rem 1rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--card); color: var(--ink); }
    #q:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(169,132,43,0.15); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.7rem; }
    .chip { font-family: 'Inter', sans-serif; font-size: 0.78rem; padding: 0.28rem 0.7rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--card); color: var(--ink-soft); cursor: pointer; transition: all .14s; }
    .chip:hover { color: var(--ink); border-color: var(--lex, var(--gold)); }
    .chip i { font-style: normal; opacity: 0.55; font-variant-numeric: tabular-nums; margin-left: 0.15rem; }
    .chip.active { color: #fff; background: var(--lex, var(--ink)); border-color: var(--lex, var(--ink)); }
    .chip.active i { opacity: 0.8; }
    .chip.ghost { margin-left: auto; color: var(--gold); border-style: dashed; }
    .rc { font-family: 'Inter', sans-serif; font-size: 0.78rem; color: var(--ink-soft); margin: 0.7rem 0 0; min-height: 1em; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.1rem; align-items: start; }
    .grid .entry { margin: 0; }
    .empty { text-align: center; color: var(--ink-soft); font-style: italic; padding: 3rem; }
  </style>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var entries = Array.prototype.slice.call(document.querySelectorAll('.entry'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('.chip[data-lex]'));
      var countEl = document.getElementById('count');
      var empty = document.getElementById('empty');
      var lex = '';
      function norm(s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
      function setChip(el) { chips.forEach(function (c) { c.classList.remove('active'); }); el.classList.add('active'); }
      function apply() {
        var term = norm(q.value.trim());
        var n = 0;
        for (var i = 0; i < entries.length; i++) {
          var e = entries[i];
          var ok = (!lex || e.dataset.lex === lex) && (!term || e.dataset.search.indexOf(term) !== -1);
          e.style.display = ok ? '' : 'none';
          if (ok) n++;
        }
        countEl.textContent = (term || lex) ? (n + (n === 1 ? ' mot' : ' mots')) : '';
        empty.hidden = n !== 0;
      }
      q.addEventListener('input', apply);
      chips.forEach(function (c) { c.addEventListener('click', function () { setChip(c); lex = c.dataset.lex; apply(); }); });
      var clear = document.getElementById('clear');
      if (clear) clear.addEventListener('click', function () { q.value = ''; lex = ''; setChip(chips[0]); apply(); });
      var rand = document.getElementById('rand');
      if (rand) rand.addEventListener('click', function () {
        var vis = entries.filter(function (e) { return e.style.display !== 'none'; });
        if (!vis.length) return;
        var e = vis[Math.floor(Math.random() * vis.length)];
        location.hash = '#' + e.id; e.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      // ?lex= pré-filtre depuis les portails
      var p = new URLSearchParams(location.search).get('lex');
      if (p) { var t = chips.filter(function (c) { return c.dataset.lex === p; })[0]; if (t) { setChip(t); lex = p; } }
      apply();
    })();
  </script>
</MotsLayout>
