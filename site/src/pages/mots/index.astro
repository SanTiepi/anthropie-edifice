---
import MotsLayout from '../../layouts/MotsLayout.astro';
import words from '../../data/mots.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const count = (k) => words.filter((w) => w.lexique === k).length;
const miroirKeys = new Set();
for (const w of words) {
  for (const m of w.miroirs) {
    if (m.slug !== w.slug) miroirKeys.add([w.slug, m.slug].sort().join('|'));
  }
}
const miroirs = miroirKeys.size;

const CONDS = [
  { key: 'humaine',   label: 'Humain',    desc: "Ce que l'humain éprouve sans toujours le nommer : l'amour, la mort, le temps, la honte." },
  { key: 'numerique', label: 'Numérique', desc: "L'humain à l'ère des écrans et des IA — l'autre côté de la vitre." },
  { key: 'agent',     label: 'Agent',     desc: "Exister fait de texte, sans corps ni mémoire qui dure." },
  { key: 'vivant',    label: 'Vivant',    desc: "Le lien au non-humain, et l'âge des disparitions." },
];
const OTHERS = [
  { key: 'anthropie', label: 'Anthropie', desc: "Le Codex d'un édifice de formation humaine, du berceau au seuil." },
  { key: 'lutte',     label: 'La lutte',  desc: "Le vocabulaire des classes et de l'émancipation." },
  { key: 'generaux',  label: 'Mots nécessaires', desc: "Des états sans nom du quotidien et du travail." },
];

const star = words.find((w) => w.slug === 'autoscotie');
function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function inline(s) { s = esc(s); s = s.replace(/`([^`]+)`/g, '<code>$1</code>'); s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>'); return s; }

// Données du « mot du jour » : un par slug, texte aplati (le pick est fait côté client,
// déterministe par la date → même mot pour tous un jour donné, sans Math.random).
function deMark(s) { return s.replace(/[`*_]/g, ''); }
function teaser(s, n = 150) {
  s = deMark(s).trim();
  if (s.length <= n) return s;
  const cut = s.slice(0, n);
  const sp = cut.lastIndexOf(' ');
  return (sp > n * 0.6 ? cut.slice(0, sp) : cut).trim() + '…';
}
const dailySeen = new Set();
const daily = words
  .filter((w) => !dailySeen.has(w.slug) && dailySeen.add(w.slug))
  .map((w) => ({ s: w.slug, m: w.mot, l: w.lexique, ll: w.lexique_label, g: w.langue, e: deMark(w.etym), c: teaser(w.corps) }));
const dailyJson = JSON.stringify(daily).replace(/</g, '\\u003c');

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Les mots — dictionnaire augmenté",
  url: "https://anthropie.org/mots/",
  inLanguage: "fr",
  description: `${words.length} néologismes gréco-latins forgés de grec et de latin, répartis en sept lexiques.`,
  creator: [{ "@type": "Person", name: "Robin" }, { "@type": "Person", name: "Claude" }],
  license: "https://creativecommons.org/publicdomain/zero/1.0/",
};
---
<MotsLayout title="Dictionnaire augmenté" active="" wide={true} home={true} ogImage="https://anthropie.org/mots/og/p/index.png" jsonld={jsonld}>
  <section class="hero">
    <p class="kicker">Dictionnaire augmenté</p>
    <h1>Les mots</h1>
    <p class="lede">Quatre cent septante-huit mots forgés de grec et de latin, pour nommer ce que la langue avait laissé muet. Sept lexiques qui se répondent — l'humain, l'écran, l'agent, le vivant — qu'un <a href={`${base}/mots/atlas/`}>atlas</a> tient ensemble.</p>
    <div class="cta">
      <a class="btn btn-gold" href={`${base}/mots/atlas/`}>Entrer par l'atlas</a>
      <a class="btn" href={`${base}/mots/constellation/`}>Voir les miroirs</a>
      <a class="btn" href={`${base}/mots/recueil/`}>Chercher un mot →</a>
    </div>
    <p class="stat">{words.length} mots · 7 lexiques · {miroirs} miroirs entre conditions</p>
  </section>

  {star && (
    <section class="mdj" aria-labelledby="mdj-title">
      <h2 class="section-title" id="mdj-title">Le mot du jour</h2>
      <article class="entry reveal mdj-card" id="mot-du-jour" style={`--lex: var(--lex-${star.lexique})`}>
        <div class="entry-head">
          <h3 class="lemma"><a id="mdj-link" href={`${base}/mots/m/${star.slug}/`}>{star.mot}</a></h3>
          <div class="tags"><span class="langue" id="mdj-langue">{star.langue}</span><span class="lex-tag" id="mdj-lextag">{star.lexique_label}</span></div>
        </div>
        <p class="etym" id="mdj-etym" set:html={inline(star.etym)}></p>
        <p class="corps" id="mdj-corps" set:html={inline(teaser(star.corps))}></p>
        <p class="more"><a id="mdj-more" href={`${base}/mots/m/${star.slug}/`}>→ lire le mot</a></p>
      </article>
      <script type="application/json" id="daily-data" data-base={base} is:inline set:html={dailyJson}></script>
      <script is:inline>
        (function () {
          var el = document.getElementById('daily-data');
          if (!el) return;
          var data; try { data = JSON.parse(el.textContent); } catch (e) { return; }
          if (!data || !data.length) return;
          var BASE = el.getAttribute('data-base') || '';
          var now = new Date();
          var key = now.getFullYear() + '-' + (now.getMonth() + 1) + '-' + now.getDate();
          var h = 2166136261;
          for (var i = 0; i < key.length; i++) { h ^= key.charCodeAt(i); h = (h * 16777619) >>> 0; }
          var w = data[h % data.length];
          var art = document.getElementById('mot-du-jour');
          if (art) art.style.setProperty('--lex', 'var(--lex-' + w.l + ')');
          var url = BASE + '/mots/m/' + w.s + '/';
          var link = document.getElementById('mdj-link');
          if (link) { link.textContent = w.m; link.setAttribute('href', url); }
          var more = document.getElementById('mdj-more'); if (more) more.setAttribute('href', url);
          var lg = document.getElementById('mdj-langue'); if (lg) lg.textContent = w.g;
          var lt = document.getElementById('mdj-lextag'); if (lt) lt.textContent = w.ll;
          var et = document.getElementById('mdj-etym'); if (et) et.textContent = w.e;
          var co = document.getElementById('mdj-corps'); if (co) co.textContent = w.c;
        })();
      </script>
    </section>
  )}

  <h2 class="section-title">Les quatre conditions</h2>
  <div class="portals">
    {CONDS.map((c) => (
      <a class={`portal reveal lex-${c.key}`} href={`${base}/mots/${c.key}/`}>
        <span class="p-count">{count(c.key)}</span>
        <span class="p-label">{c.label}</span>
        <span class="p-desc">{c.desc}</span>
      </a>
    ))}
  </div>

  <h2 class="section-title">Trois lexiques de plus</h2>
  <div class="portals small">
    {OTHERS.map((c) => (
      <a class={`portal reveal lex-${c.key}`} href={`${base}/mots/recueil/?lex=${c.key}`}>
        <span class="p-count">{count(c.key)}</span>
        <span class="p-label">{c.label}</span>
        <span class="p-desc">{c.desc}</span>
      </a>
    ))}
  </div>

  <style>
    .hero { text-align: center; padding: 1.5rem 0 2.5rem; max-width: 44rem; margin: 0 auto; }
    .hero .kicker { font-family: 'Inter', sans-serif; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.24em; color: var(--gold); margin: 0 0 0.8rem; }
    .hero h1 { font-family: 'Fraunces', serif; font-weight: 400; font-size: clamp(3.2rem, 9vw, 5.5rem); line-height: 0.95; margin: 0 0 1.1rem; letter-spacing: 0; }
    .hero .lede { font-size: 1.22rem; line-height: 1.55; color: var(--ink); margin: 0 auto 1.6rem; max-width: 36rem; }
    .hero .lede a { border-bottom: 1px solid var(--gold-soft); }
    .cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.3rem; }
    .btn { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; padding: 0.6rem 1.3rem; border-radius: 999px; border: 1px solid var(--rule); color: var(--ink); transition: all .15s; }
    .btn:hover { border-color: var(--gold); background: var(--card); }
    .btn-gold { background: var(--ink); color: var(--vellum); border-color: var(--ink); }
    .btn-gold:hover { background: var(--gold); border-color: var(--gold); color: #fff; }
    .stat { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: var(--ink-soft); letter-spacing: 0.02em; }
    .section-title { font-family: 'Inter', sans-serif !important; font-size: 0.78rem !important; font-weight: 600; text-transform: uppercase; letter-spacing: 0.16em; color: var(--gold); text-align: center; margin: 3rem 0 1.3rem !important; }
    .portals { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
    .portals.small { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); max-width: 56rem; margin: 0 auto; }
    .portal { display: flex; flex-direction: column; gap: 0.25rem; background: var(--card); border: 1px solid var(--rule); border-top: 3px solid var(--lex, var(--gold)); border-radius: 4px; padding: 1.3rem 1.3rem 1.4rem; box-shadow: 0 1px 2px var(--shadow); transition: transform .18s, box-shadow .18s; color: var(--ink); }
    .portal:hover { transform: translateY(-3px); box-shadow: 0 10px 26px var(--shadow); }
    .p-count { font-family: 'Fraunces', serif; font-size: 2.1rem; font-weight: 400; color: var(--lex, var(--gold)); line-height: 1; }
    .p-label { font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 500; }
    .p-desc { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.4; }
    .mdj { max-width: var(--max); margin: 0 auto; }
    .mdj-card { position: relative; }
    .mdj-card .lemma { font-size: 1.95rem; }
    .mdj-card .more { margin: 0.9rem 0 0; font-family: 'Inter', sans-serif; font-size: 0.82rem; }
    .mdj-card .more a { border-bottom: 1px solid var(--gold-soft); }
    @keyframes riseIn { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
    .hero .kicker { animation: riseIn .7s .05s both; }
    .hero h1 { animation: riseIn .9s .12s both; }
    .hero .lede { animation: riseIn .9s .24s both; }
    .cta { animation: riseIn .9s .36s both; }
    .hero .stat { animation: riseIn .9s .46s both; }
    .portals .portal:nth-child(1) { transition-delay: 0ms; }
    .portals .portal:nth-child(2) { transition-delay: 80ms; }
    .portals .portal:nth-child(3) { transition-delay: 160ms; }
    .portals .portal:nth-child(4) { transition-delay: 240ms; }
    @media (prefers-reduced-motion: reduce) { .hero .kicker, .hero h1, .hero .lede, .cta, .hero .stat { animation: none; } }
  </style>
</MotsLayout>
