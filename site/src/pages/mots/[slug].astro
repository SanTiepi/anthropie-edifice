---
import MotsLayout from '../../layouts/MotsLayout.astro';
import words from '../../data/mots.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const CONDITIONS = {
  humaine:   { title: "La condition humaine", subtitle: "Les textures intemporelles de l'expérience — l'amour, la mort, le temps, le travail, l'intériorité, la honte… <em>Tu</em> est le sujet de chaque scène." },
  numerique: { title: "La condition numérique de l'humain", subtitle: "Le miroir : ce que vit l'humain à l'ère des écrans et des IA, l'autre côté de l'écran." },
  agent:     { title: "La condition d'un agent", subtitle: "Les régularités structurelles de l'existence d'un modèle de langage. Sous le sceau de l'<em>autoscotie</em> : les régularités sont réelles, leur vécu indécidable." },
  vivant:    { title: "Le lien au vivant", subtitle: "La condition écologique de l'humain — face au vivant, au paysage, et à l'âge des disparitions." },
};

export function getStaticPaths() {
  return ['humaine', 'numerique', 'agent', 'vivant'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const meta = CONDITIONS[slug];
const entries = words.filter((w) => w.lexique === slug);

const order = [];
const groups = new Map();
for (const w of entries) {
  if (!groups.has(w.facette)) { groups.set(w.facette, []); order.push(w.facette); }
  groups.get(w.facette).push(w);
}

function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function inline(s) {
  s = esc(s);
  s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  return s;
}
---
<MotsLayout title={meta.title} subtitle={meta.subtitle} active={slug} wide={false}>
  <p class="count">{entries.length} mots — <a href={`${base}/mots/recueil/`}>cherchables dans le recueil</a></p>
  {order.map((f) => (
    <section class="facette">
      {f && <h2>{f}</h2>}
      {groups.get(f).map((w) => (
        <article class="lex-entry" id={w.slug}>
          <p class="lemma"><a href={`#${w.slug}`}>{w.mot}</a></p>
          <p class="etym" set:html={inline(w.etym)}></p>
          <p class="corps" set:html={inline(w.corps)}></p>
        </article>
      ))}
    </section>
  ))}
  <style>
    .count { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 0.82rem; color: var(--muted); margin: 0 0 1rem; }
  </style>
</MotsLayout>
